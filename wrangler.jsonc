{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "black-x-anime",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "observability": {
    "enabled": true
  },
  "alias": {
    "better-sqlite3": "./worker/stubs/better-sqlite3.js"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BLACKX_API",
        "class_name": "BlackXApiState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-blackx-sqlite",
      "new_sqlite_classes": [
        "BlackXApiState"
      ]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/search-anime*",
      "/get-episodes*",
      "/get-episode-dl*",
      "/latest-episodes",
      "/fetch-seasonals",
      "/get-anime-info*"
    ]
  }
}
