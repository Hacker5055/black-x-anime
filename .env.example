DATABASE_URL=
PORT=3000
# Set a random 32+ character secret in production (for example: openssl rand -base64 48).
JWT_SECRET=
# Optional comma-separated exact origins for trusted cross-origin clients.
CORS_ORIGINS=
# Optional: Firebase service-account key for server-side Firestore access
# (Firebase console > Project settings > Service accounts > Generate new private key).
# Paste the whole JSON file, or its base64 encoding. Never commit the real key.
# GET /api/health reports firestoreAuth: "service_account" once it works.
FIREBASE_SERVICE_ACCOUNT=
REDIS_URL=

# Optional BLACK X 4 (AniProject v3) search/stream/reader adapter.
# Use the URL of your own deployed AniProject *backend* (not the GitHub release or website).
# In production use HTTPS; local HTTP localhost is accepted only in development.
ANIPROJECT_API_URL=
# Optional media CDN domains (comma-separated, no scheme; their subdomains are
# included) for the allowlisted HLS/video proxy when playback is blocked by CORS.
ANIPROJECT_MEDIA_HOSTS=
